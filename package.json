{
  "name": "teleport",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json && vite build",
    "start": "node --no-warnings dist-server/index.js",
    "desktop:dev": "tauri dev",
    "desktop:check": "tsc --noEmit && cargo check --manifest-path src-tauri/Cargo.toml",
    "desktop:build": "tauri build --no-bundle",
    "desktop:standalone:linux": "tauri build --no-bundle",
    "desktop:standalone:windows": "tauri build --target x86_64-pc-windows-msvc --no-bundle --no-sign",
    "desktop:standalone:macos:x64": "tauri build --target x86_64-apple-darwin --no-bundle --no-sign",
    "desktop:standalone:macos:arm64": "tauri build --target aarch64-apple-darwin --no-bundle --no-sign",
    "desktop:bundle:linux": "tauri build --bundles deb rpm",
    "desktop:build:macos": "tauri build --target universal-apple-darwin --no-sign",
    "desktop:build:windows": "tauri build --target x86_64-pc-windows-msvc --no-sign"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-global-shortcut": "^2.3.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-store": "^2.4.3",
    "@vitejs/plugin-react": "^5.1.1",
    "crypto-js": "^4.2.0",
    "express": "^5.2.1",
    "lucide-react": "^0.561.0",
    "multer": "^2.0.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "vite": "^7.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.2",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.23",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24"
  }
}
