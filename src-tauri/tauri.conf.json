{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "teleport",
  "version": "1.2.0",
  "identifier": "dev.teleport.desktop",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 1420",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "teleport",
        "label": "main",
        "width": 1120,
        "height": 740,
        "minWidth": 560,
        "minHeight": 420,
        "center": true,
        "devtools": true,
        "visible": false
      },
      {
        "title": "teleport",
        "label": "mini",
        "width": 430,
        "height": 560,
        "minWidth": 300,
        "minHeight": 320,
        "center": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "devtools": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
