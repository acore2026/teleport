{
  "name": "teleport",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && tsc -p tsconfig.server.json && vite build",
    "start": "node --no-warnings dist-server/index.js",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "crypto-js": "^4.2.0",
    "express": "^5.2.1",
    "multer": "^2.0.2",
    "vite": "^7.3.0",
    "vue": "^3.5.0",
    "lucide-vue-next": "^0.561.0"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.0.3",
    "autoprefixer": "^10.4.23",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "@vitejs/plugin-vue": "^6.0.0",
    "vue-tsc": "^3.1.0"
  },
  "engines": {
    "node": ">=24"
  }
}
